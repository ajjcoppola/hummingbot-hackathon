<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Install (once):
    cp scripts/com.hummingbot.pool-snapshots.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.hummingbot.pool-snapshots.plist

  Read-only. Never touches LP / Gateway / Hummingbot.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hummingbot.pool-snapshots</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/ajjc/proj/hummingbot-hackathon/scripts/launch_pool_snapshots.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ajjc/proj/hummingbot-hackathon</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/ajjc/proj/hummingbot-hackathon/data/pool_snapshots_launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ajjc/proj/hummingbot-hackathon/data/pool_snapshots_launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>

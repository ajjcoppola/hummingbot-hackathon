<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Dump-protected −3% equity kill (S002 companion).

  Install (once):
    cp scripts/com.hummingbot.equity-kill.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.hummingbot.equity-kill.plist

  Optional: set EQUITY_KILL_OPEN to the deploy-time book USD so the baseline
  is not taken from the first poll after a partial fill.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hummingbot.equity-kill</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/ajjc/proj/hummingbot-hackathon/scripts/launch_equity_kill.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ajjc/proj/hummingbot-hackathon</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/ajjc/proj/hummingbot-hackathon/data/equity_kill/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ajjc/proj/hummingbot-hackathon/data/equity_kill/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/Users/ajjc/.orbstack/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>EQUITY_KILL_PCT</key>
    <string>0.03</string>
    <key>EQUITY_KILL_INTERVAL</key>
    <string>60</string>
  </dict>
</dict>
</plist>
